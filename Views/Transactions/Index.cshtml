@model TransactionFilterViewModel
@{
    ViewData["Title"] = "Операции";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">
            <i class="bi bi-arrow-left-right text-primary me-2"></i>Финансовые операции
        </h2>
        <div class="text-muted small">Список поступлений и расходов</div>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Добавить
        </a>
    </div>
</div>

<!-- Форма фильтрации операций -->
<div class="card shadow-sm mb-4 filter-panel">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3 col-sm-6">
                <label class="form-label small fw-semibold">С даты</label>
                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label small fw-semibold">По дату</label>
                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label small fw-semibold">Тип</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">Все типы</option>
                    <option value="Income" selected="@(Model.Type == TransactionType.Income)">Доходы (+)</option>
                    <option value="Expense" selected="@(Model.Type == TransactionType.Expense)">Расходы (-)</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label small fw-semibold">Категория</label>
                <select name="categoryId" asp-items="Model.CategoryOptions" class="form-select form-select-sm">
                    <option value="">Все категории</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-12">
                <label class="form-label small fw-semibold">Поиск</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Поиск в примечании" class="form-control form-control-sm" />
            </div>

            <div class="col-12 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    Сбросить
                </a>
                <button type="submit" class="btn btn-sm btn-primary">
                    Применить
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Сводка по выбранным фильтрам -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="p-3 bg-body-tertiary border rounded shadow-sm d-flex justify-content-between align-items-center">
            <span class="text-muted small">Доходы:</span>
            <span class="fw-bold amount-income">+@Model.FilteredIncome.ToString("N2") @Model.CurrencySymbol</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-body-tertiary border rounded shadow-sm d-flex justify-content-between align-items-center">
            <span class="text-muted small">Расходы:</span>
            <span class="fw-bold amount-expense">-@Model.FilteredExpense.ToString("N2") @Model.CurrencySymbol</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-body-tertiary border rounded shadow-sm d-flex justify-content-between align-items-center">
            <span class="text-muted small">Итог:</span>
            <span class="fw-bold @(Model.FilteredBalance >= 0 ? "text-primary" : "text-danger")">
                @(Model.FilteredBalance >= 0 ? "+" : "")@Model.FilteredBalance.ToString("N2") @Model.CurrencySymbol
            </span>
        </div>
    </div>
</div>

<!-- Таблица транзакций -->
<div class="card shadow-sm table-rounded">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 110px;">Дата</th>
                    <th>Категория</th>
                    <th>Тип</th>
                    <th>Примечание</th>
                    <th class="text-end">Сумма</th>
                    <th class="text-center" style="width: 120px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions.Any())
                {
                    @foreach (var t in Model.Transactions)
                    {
                        var isIncome = t.Category?.Type == TransactionType.Income;
                        <tr>
                            <td class="text-muted small">
                                @t.Date.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white me-2" 
                                          style="width: 30px; height: 30px; background-color: @(t.Category?.ColorHex ?? "#6c757d"); font-size: 0.85rem;">
                                        <i class="bi @(t.Category?.Icon ?? "bi-tag")"></i>
                                    </span>
                                    <span>@(t.Category?.Name ?? "Без категории")</span>
                                </div>
                            </td>
                            <td>
                                @if (isIncome)
                                {
                                    <span class="badge text-bg-success px-2 py-1">Доход</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger px-2 py-1">Расход</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrEmpty(t.Note) ? "—" : t.Note)
                            </td>
                            <td class="text-end fw-bold @(isIncome ? "text-success" : "text-danger")">
                                @(isIncome ? "+" : "-")@t.Amount.ToString("N2") @Model.CurrencySymbol
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-outline-secondary" title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Удалить" 
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@t.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <div class="modal fade" id="deleteModal-@t.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content text-start">
                                            <div class="modal-header">
                                                <h6 class="modal-title fw-bold">Удалить операцию?</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                                            </div>
                                            <div class="modal-body small">
                                                Удалить операцию на сумму @t.Amount.ToString("N2") @Model.CurrencySymbol?
                                            </div>
                                            <div class="modal-footer p-2">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                                <form asp-action="Delete" asp-route-id="@t.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Операции не найдены.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">
                Всего: @Model.TotalItems
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-type="@Model.Type"
                       asp-route-searchTerm="@Model.SearchTerm">«</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@p"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-type="@Model.Type"
                           asp-route-searchTerm="@Model.SearchTerm">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-type="@Model.Type"
                       asp-route-searchTerm="@Model.SearchTerm">»</a>
                </li>
            </ul>
        </div>
    }
</div>
