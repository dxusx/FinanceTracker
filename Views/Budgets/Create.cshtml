@model BudgetViewModel
@{
    ViewData["Title"] = "Новый бюджет";
    var monthNames = new[] { "", "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь" };
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent py-3">
                <h5 class="card-title fw-bold mb-0">
                    <i class="bi bi-bullseye text-primary me-2"></i>Новый лимит расходов
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label asp-for="Month" class="form-label small fw-semibold"></label>
                            <select asp-for="Month" class="form-select">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == Model.Month)">@monthNames[m]</option>
                                }
                            </select>
                            <span asp-validation-for="Month" class="text-danger small"></span>
                        </div>
                        <div class="col-5">
                            <label asp-for="Year" class="form-label small fw-semibold"></label>
                            <select asp-for="Year" class="form-select">
                                @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                                {
                                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                                }
                            </select>
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label small fw-semibold"></label>
                        @if (Model.CategoryOptions.Any())
                        {
                            <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                                <option value="">-- Выберите категорию --</option>
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning small mb-0">
                                На выбранный месяц лимиты уже заданы для всех категорий.
                            </div>
                        }
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MonthlyLimit" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₽</span>
                            <input asp-for="MonthlyLimit" class="form-control form-control-lg fw-bold" placeholder="0.00" type="number" step="0.01" min="0.01" />
                        </div>
                        <span asp-validation-for="MonthlyLimit" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Отмена
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold" @(Model.CategoryOptions.Any() ? "" : "disabled")>
                            Сохранить
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
