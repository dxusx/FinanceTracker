<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Учет финансов</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: 600;
        }

        .footer {
            margin-top: auto;
            border-top: 1px solid var(--bs-border-color);
            padding: 1rem 0;
            font-size: 0.9rem;
        }

        .stat-card {
            border-left: 4px solid var(--bs-primary);
        }
        .stat-card.stat-income {
            border-left-color: var(--bs-success) !important;
        }
        .stat-card.stat-expense {
            border-left-color: var(--bs-danger) !important;
        }
        .stat-card.stat-balance {
            border-left-color: var(--bs-primary) !important;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-wallet2 text-primary fs-4"></i>
                    <span>Учет финансов</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Навигация">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active fw-bold text-primary" : "")" 
                                   asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Дашборд
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active fw-bold text-primary" : "")" 
                                   asp-controller="Transactions" asp-action="Index">
                                    <i class="bi bi-arrow-left-right me-1"></i> Операции
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active fw-bold text-primary" : "")" 
                                   asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-tags me-1"></i> Категории
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budgets" ? "active fw-bold text-primary" : "")" 
                                   asp-controller="Budgets" asp-action="Index">
                                    <i class="bi bi-bullseye me-1"></i> Бюджеты
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle-btn" title="Тема">
                                <i class="bi bi-moon-stars theme-icon"></i>
                            </button>

                            <a class="btn btn-sm btn-success text-white" asp-controller="Transactions" asp-action="Create" asp-route-type="Income">
                                <i class="bi bi-plus-circle me-1"></i> Доход
                            </a>
                            <a class="btn btn-sm btn-danger text-white" asp-controller="Transactions" asp-action="Create" asp-route-type="Expense">
                                <i class="bi bi-dash-circle me-1"></i> Расход
                            </a>

                            <div class="dropdown ms-2">
                                <button class="btn btn-outline-primary btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@(User.Identity.Name ?? "Профиль")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><h6 class="dropdown-header">@(User.Identity.Name)</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Выйти
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 ms-auto">
                            <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle-btn" title="Тема">
                                <i class="bi bi-moon-stars theme-icon"></i>
                            </button>

                            <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Вход
                            </a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Регистрация
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid px-4 py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer text-center text-body-secondary bg-body-tertiary">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div>
                &copy; @DateTime.Now.Year — <strong>Учет финансов</strong>
            </div>
            <div class="small text-muted">
                ASP.NET Core
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function applyTheme(theme) {
            document.documentElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem('theme', theme);

            document.querySelectorAll('.theme-icon').forEach(function (icon) {
                icon.className = theme === 'dark' ? 'bi bi-sun-fill text-warning theme-icon' : 'bi bi-moon-stars theme-icon';
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
            applyTheme(currentTheme);

            document.querySelectorAll('.theme-toggle-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const activeTheme = document.documentElement.getAttribute('data-bs-theme');
                    const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                    applyTheme(newTheme);
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
