@model IEnumerable<Category>
@{
    ViewData["Title"] = "Категории";
    var incomeCategories = Model.Where(c => c.Type == TransactionType.Income).ToList();
    var expenseCategories = Model.Where(c => c.Type == TransactionType.Expense).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">
            <i class="bi bi-grid text-primary me-2"></i>Категории
        </h2>
        <div class="text-muted small">Список категорий для доходов и расходов</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Добавить категорию
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success">
                    <i class="bi bi-arrow-up-circle-fill me-2"></i>Доходы
                </span>
                <span class="badge text-bg-success">
                    @incomeCategories.Count
                </span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var cat in incomeCategories)
                {
                    var isSystem = cat.UserId == null;
                    var transCount = cat.Transactions.Count;
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div class="d-flex align-items-center">
                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white me-3" 
                                  style="width: 36px; height: 36px; background-color: @cat.ColorHex;">
                                <i class="bi @cat.Icon"></i>
                            </span>
                            <div>
                                <div class="fw-semibold">@cat.Name</div>
                                <div class="text-muted small">
                                    @if (isSystem)
                                    {
                                        <span class="badge text-bg-secondary">Общая</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">Пользовательская</span>
                                    }
                                    <span class="ms-2">Операций: @transCount</span>
                                </div>
                            </div>
                        </div>

                        @if (!isSystem)
                        {
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger" title="Удалить" 
                                        data-bs-toggle="modal" data-bs-target="#deleteCatModal-@cat.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <div class="modal fade" id="deleteCatModal-@cat.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-sm">
                                    <div class="modal-content text-start">
                                        <div class="modal-header">
                                            <h6 class="modal-title fw-bold">Удалить категорию?</h6>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                                        </div>
                                        <div class="modal-body small">
                                            Удалить категорию <strong>@cat.Name</strong>?
                                        </div>
                                        <div class="modal-footer p-2">
                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-danger">
                    <i class="bi bi-arrow-down-circle-fill me-2"></i>Расходы
                </span>
                <span class="badge text-bg-danger">
                    @expenseCategories.Count
                </span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var cat in expenseCategories)
                {
                    var isSystem = cat.UserId == null;
                    var transCount = cat.Transactions.Count;
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div class="d-flex align-items-center">
                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white me-3" 
                                  style="width: 36px; height: 36px; background-color: @cat.ColorHex;">
                                <i class="bi @cat.Icon"></i>
                            </span>
                            <div>
                                <div class="fw-semibold">@cat.Name</div>
                                <div class="text-muted small">
                                    @if (isSystem)
                                    {
                                        <span class="badge text-bg-secondary">Общая</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">Пользовательская</span>
                                    }
                                    <span class="ms-2">Операций: @transCount</span>
                                </div>
                            </div>
                        </div>

                        @if (!isSystem)
                        {
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger" title="Удалить" 
                                        data-bs-toggle="modal" data-bs-target="#deleteCatModal-@cat.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <div class="modal fade" id="deleteCatModal-@cat.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-sm">
                                    <div class="modal-content text-start">
                                        <div class="modal-header">
                                            <h6 class="modal-title fw-bold">Удалить категорию?</h6>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                                        </div>
                                        <div class="modal-body small">
                                            Удалить категорию <strong>@cat.Name</strong>?
                                        </div>
                                        <div class="modal-footer p-2">
                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
